# Server
PORT=3001
# Comma-separated list of allowed frontend origins for CORS.
# Local dev default used when unset: http://localhost:3000 (+127.0.0.1)
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database (Prisma)
DATABASE_URL=postgresql://user:password@localhost:5432/ai_interviewer

# Deepgram (Voice Speech-to-Text token generation) — backend-only, never expose to frontend
DEEPGRAM_API_KEY=

# AI provider: "gemini" (uses GEMINI_API_KEY directly, recommended for Render)
# or "omniroute" (requires OMNIROUTE_* below). OmniRoute is optional.
AI_PROVIDER=gemini
GEMINI_API_KEY=

# OmniRoute (OPTIONAL local AI gateway — omit entirely in production)
# OMNIROUTE_URL=http://localhost:20128
# OMNIROUTE_API_KEY=
# OMNIROUTE_MODEL=oc/big-pickle

# Firebase Admin (Optional)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# GitHub scraper proxy (Optional)
PROXY_URL=
