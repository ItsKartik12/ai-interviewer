# PostgreSQL (legacy interview flow — Phase 2+ will migrate to Firestore)
DATABASE_URL=postgresql://user:password@localhost:5432/ai_interviewer

# Google Gemini (server-side only — never expose to frontend)
GEMINI_API_KEY=

# Firebase Admin (server-side only)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Legacy OpenAI Realtime (existing voice interview — optional until Phase 5)
OPENAI_KEY=

# GitHub scraper proxy (legacy — optional)
PROXY_URL=

# Server
PORT=3001
FRONTEND_URL=http://localhost:3000
