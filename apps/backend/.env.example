# Server
PORT=3001
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database (Prisma)
DATABASE_URL=postgresql://user:password@localhost:5432/ai_interviewer

# Deepgram (Voice Speech-to-Text token generation)
DEEPGRAM_API_KEY=

# OmniRoute (AI Gateway for interview questions and evaluations)
OMNIROUTE_URL=http://localhost:20128
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=oc/big-pickle

# Google Gemini (Optional server-side fallback)
GEMINI_API_KEY=

# Firebase Admin (Optional)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# GitHub scraper proxy (Optional)
PROXY_URL=
