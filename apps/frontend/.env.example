# Backend API origin. On Vercel set this to your Render backend URL, e.g.
# PUBLIC_BACKEND_URL=https://<your-service>.onrender.com
# For local development the Vite dev server falls back to http://localhost:3001.
PUBLIC_BACKEND_URL=http://localhost:3001

# Firebase client config (safe to expose in browser)
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
